{
  "name": "virtue-clockin-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contracts": "openapi-typescript ../contracts/openapi.json -o src/generated/schema.d.ts",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "lucide-react": "latest",
    "next": "latest",
    "openapi-fetch": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/google.maps": "^3.66.5",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9.39.5",
    "eslint-config-next": "latest",
    "jsdom": "latest",
    "openapi-typescript": "latest",
    "prettier": "latest",
    "tailwindcss": "latest",
    "typescript": "~5.9.3",
    "vitest": "latest"
  }
}
