# Local loopback hostname follows the browser for session-cookie compatibility.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Google Maps browser key (website/API restricted) and your JavaScript map ID.
# Enable Maps JavaScript API and Geocoding API with billing in your Google project.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
