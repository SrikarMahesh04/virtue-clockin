APP_ENV=development
# Required: provision your own empty PostgreSQL database, then run migrations.
DATABASE_URL=
FRONTEND_ORIGIN=http://localhost:3000
# Optional comma-separated exact LAN browser origins (development/test only).
# The Windows backend launcher detects current private IPv4 origins automatically.
FRONTEND_ADDITIONAL_ORIGINS=
APP_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
# Enable only for known trusted reverse proxies. Direct local requests need none.
TRUSTED_PROXY_CIDRS=
# Leave empty locally. Production shares a private random value with the Netlify edge proxy.
CLOCKIN_PROXY_SECRET=
# SMTP is optional. Recovery reports unavailable when absent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
